PORT=5001
PUBLIC_BASE_URL=http://localhost:5001

PGUSER=kurbanali
PGHOST=localhost
PGDATABASE=kurbanali_db
PGPASSWORD=0000
PGPORT=5432

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Voice / TTS routing
# Without an ElevenLabs key, set EN:edge,RU:edge,KG:edge,UZ:edge (no Kyrgyz Edge voice exists; KG falls back to Kazakh).
TTS_LANG_PROVIDER_MAP=EN:eleven,RU:eleven,KG:eleven,UZ:eleven

# ElevenLabs (primary for all languages; eleven_v4 natively supports Kyrgyz and Uzbek)
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Recommended for kid-friendly clear voice:
ELEVEN_VOICE_STABILITY=0.58
ELEVEN_VOICE_SIMILARITY_BOOST=0.72
ELEVEN_VOICE_STYLE=0.28
ELEVEN_VOICE_SPEAKER_BOOST=true
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_RU=
ELEVENLABS_VOICE_KG=
ELEVENLABS_VOICE_UZ=

# OpenAI (primary for UZ, fallback for other languages)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=mp3
TTS_CACHE_MAX_ENTRIES=20000

# Edge TTS fallback (no API key required)
EDGE_TTS_PYTHON_BIN=python3
EDGE_TTS_REQUEST_TIMEOUT_MS=30000
EDGE_VOICE_EN=en-US-EmmaNeural
EDGE_VOICE_RU=ru-RU-SvetlanaNeural
EDGE_VOICE_KG=kk-KZ-AigulNeural
EDGE_VOICE_UZ=uz-UZ-MadinaNeural

# OpenAI API key (used by AI tutor and OpenAI TTS)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
